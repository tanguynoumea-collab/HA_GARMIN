{
  "$schema": "https://raw.githubusercontent.com/house-of-abbey/GarminHomeAssistant/main/config.schema.json",
  "title": "🏠 Domotique Divonne",
  "items": [
    {
      "type": "group",
      "name": "Lumières",
      "title": "Contrôle des Lumières",
      "items": [
        {
          "type": "toggle",
          "name": "Salon",
          "entity": "light.salon_salon"
        },
        {
          "type": "toggle",
          "name": "Bureau",
          "entity": "light.bureau_bureau"
        },
        {
          "type": "toggle",
          "name": "Bureau Shelly",
          "entity": "switch.bureau_shelly_bureau"
        },
        {
          "type": "toggle",
          "name": "Chambre",
          "entity": "light.chambre_chambre"
        },
        {
          "type": "toggle",
          "name": "Jardin",
          "entity": "light.jardin_jardin"
        },
        {
          "type": "toggle",
          "name": "Jardin Shelly",
          "entity": "switch.jardin_shelly_jardin"
        },
        {
          "type": "toggle",
          "name": "Coin TV",
          "entity": "light.coin_tele_coin_tele"
        }
      ]
    },
    {
      "type": "group",
      "name": "Caméras",
      "title": "Caméras & Détecteurs",
      "items": [
        {
          "type": "group",
          "name": "Caméra Bureau",
          "title": "Bureau",
          "items": [
            {
              "type": "info",
              "name": "Mouvement",
              "content": "{{ states('binary_sensor.bureau_mouvement') }}"
            },
            {
              "type": "info",
              "name": "Personne",
              "content": "{{ states('binary_sensor.bureau_personne') }}"
            },
            {
              "type": "info",
              "name": "Animaux",
              "content": "{{ states('binary_sensor.bureau_animal') }}"
            }
          ]
        },
        {
          "type": "group",
          "name": "Caméra Salon",
          "title": "Salon",
          "items": [
            {
              "type": "info",
              "name": "Mouvement",
              "content": "{{ states('binary_sensor.salon_mouvement') }}"
            },
            {
              "type": "info",
              "name": "Personne",
              "content": "{{ states('binary_sensor.salon_personne') }}"
            },
            {
              "type": "info",
              "name": "Animaux",
              "content": "{{ states('binary_sensor.salon_animal') }}"
            }
          ]
        },
        {
          "type": "group",
          "name": "Caméra Jardin",
          "title": "Jardin",
          "items": [
            {
              "type": "info",
              "name": "Mouvement",
              "content": "{{ states('binary_sensor.jardin_mouvement') }}"
            },
            {
              "type": "info",
              "name": "Personne",
              "content": "{{ states('binary_sensor.jardin_personne') }}"
            },
            {
              "type": "info",
              "name": "Animaux",
              "content": "{{ states('binary_sensor.jardin_animal') }}"
            }
          ]
        }
      ]
    },
    {
      "type": "group",
      "name": "Volets",
      "title": "Volets Roulants",
      "items": [
        {
          "type": "group",
          "name": "Chambre",
          "title": "Volet Chambre",
          "items": [
            {
              "type": "info",
              "name": "Position",
              "content": "{{ (state_attr('cover.chambre_volet_roulant_1', 'current_position') | int(0)) }}%"
            },
            {
              "type": "tap",
              "name": "Ouvrir",
              "entity": "cover.chambre_volet_roulant_1",
              "tap_action": {
                "service": "cover.open_cover",
                "target": {
                  "entity_id": "cover.chambre_volet_roulant_1"
                }
              }
            },
            {
              "type": "tap",
              "name": "Fermer",
              "entity": "cover.chambre_volet_roulant_1",
              "tap_action": {
                "service": "cover.close_cover",
                "target": {
                  "entity_id": "cover.chambre_volet_roulant_1"
                }
              }
            },
            {
              "type": "tap",
              "name": "25%",
              "entity": "cover.chambre_volet_roulant_1",
              "tap_action": {
                "service": "cover.set_cover_position",
                "target": {
                  "entity_id": "cover.chambre_volet_roulant_1"
                },
                "data": {
                  "position": 25
                }
              }
            },
            {
              "type": "tap",
              "name": "50%",
              "entity": "cover.chambre_volet_roulant_1",
              "tap_action": {
                "service": "cover.set_cover_position",
                "target": {
                  "entity_id": "cover.chambre_volet_roulant_1"
                },
                "data": {
                  "position": 50
                }
              }
            },
            {
              "type": "tap",
              "name": "75%",
              "entity": "cover.chambre_volet_roulant_1",
              "tap_action": {
                "service": "cover.set_cover_position",
                "target": {
                  "entity_id": "cover.chambre_volet_roulant_1"
                },
                "data": {
                  "position": 75
                }
              }
            }
          ]
        },
        {
          "type": "group",
          "name": "Bureau",
          "title": "Volet Bureau",
          "items": [
            {
              "type": "info",
              "name": "Position",
              "content": "{{ (state_attr('cover.volet_roulant_2', 'current_position') | int(0)) }}%"
            },
            {
              "type": "tap",
              "name": "Ouvrir",
              "entity": "cover.volet_roulant_2",
              "tap_action": {
                "service": "cover.open_cover",
                "target": {
                  "entity_id": "cover.volet_roulant_2"
                }
              }
            },
            {
              "type": "tap",
              "name": "Fermer",
              "entity": "cover.volet_roulant_2",
              "tap_action": {
                "service": "cover.close_cover",
                "target": {
                  "entity_id": "cover.volet_roulant_2"
                }
              }
            },
            {
              "type": "tap",
              "name": "25%",
              "entity": "cover.volet_roulant_2",
              "tap_action": {
                "service": "cover.set_cover_position",
                "target": {
                  "entity_id": "cover.volet_roulant_2"
                },
                "data": {
                  "position": 25
                }
              }
            },
            {
              "type": "tap",
              "name": "50%",
              "entity": "cover.volet_roulant_2",
              "tap_action": {
                "service": "cover.set_cover_position",
                "target": {
                  "entity_id": "cover.volet_roulant_2"
                },
                "data": {
                  "position": 50
                }
              }
            },
            {
              "type": "tap",
              "name": "75%",
              "entity": "cover.volet_roulant_2",
              "tap_action": {
                "service": "cover.set_cover_position",
                "target": {
                  "entity_id": "cover.volet_roulant_2"
                },
                "data": {
                  "position": 75
                }
              }
            }
          ]
        }
      ]
    },
    {
      "type": "group",
      "name": "Serrure",
      "title": "Serrure Nuki",
      "items": [
        {
          "type": "toggle",
          "name": "Nuki (Porte)",
          "entity": "lock.nuki_home_tanguy"
        }
      ]
    },
    {
      "type": "group",
      "name": "Aspiration",
      "title": "Aspirateur Saros",
      "items": [
        {
          "type": "tap",
          "name": "Quotidien",
          "entity": "button.salon_saros_10_quotidien",
          "tap_action": {
            "service": "button.press",
            "target": {
              "entity_id": "button.salon_saros_10_quotidien"
            }
          }
        },
        {
          "type": "tap",
          "name": "Chat 🐱",
          "entity": "button.salon_saros_10_chat",
          "tap_action": {
            "service": "button.press",
            "target": {
              "entity_id": "button.salon_saros_10_chat"
            }
          }
        },
        {
          "type": "tap",
          "name": "1x Semaine",
          "entity": "button.salon_saros_10_1x_semaine",
          "tap_action": {
            "service": "button.press",
            "target": {
              "entity_id": "button.salon_saros_10_1x_semaine"
            }
          }
        }
      ]
    },
    {
      "type": "group",
      "name": "Capteurs",
      "title": "Capteurs",
      "items": [
        {
          "type": "info",
          "name": "Température",
          "content": "{{ states('sensor.sonoff_temp_1_temperature') }}°C"
        },
        {
          "type": "info",
          "name": "Humidité",
          "content": "{{ states('sensor.sonoff_temp_1_humidite') }}%"
        },
        {
          "type": "info",
          "name": "iPhone Battery",
          "content": "{{ states('sensor.iphone_de_tanguy_battery_level') }}%"
        },
        {
          "type": "info",
          "name": "Nuki Battery",
          "content": "{{ states('sensor.nuki_home_tanguy_battery') }}%"
        }
      ]
    },
    {
      "type": "group",
      "name": "État",
      "title": "État du Système",
      "items": [
        {
          "type": "info",
          "name": "Tanguy (Position)",
          "content": "{{ states('person.tanguy_delrieu') }}"
        },
        {
          "type": "info",
          "name": "Météo",
          "content": "{{ states('weather.forecast_maison') }}"
        }
      ]
    }
  ]
}
